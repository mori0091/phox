// -------------------------------------------------------------
/// `for` loop function
/// for: ∀ a. a -> (a -> Bool) -> (a -> a) -> a
let for = ::core::__for__;

/// `while` loop function
/// while: ∀ a. (a -> Bool) -> (a -> a) -> a -> a
let while = \pred.\next.\init.
    for init pred next
;

// -------------------------------------------------------------
// === Functor ===
trait Functor f {
    fmap: (a -> b) -> f a -> f b;
};

// === Applicative Functor ===
trait Applicative f {
    pure : a -> f a;
    afmap: f (a -> b) -> f a -> f b;
};

// === Monad ===
trait Monad m {
    (?>) : m a -> (a -> m b) -> m b;
};
